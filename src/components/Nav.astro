---
const links = [
  { href: '/blog/', label: 'Writing' },
  { href: '/how-we-work/', label: 'How we work' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
];
const path = Astro.url.pathname;
---

<header transition:persist>
  <div class="container inner">
    <a class="wordmark" href="/" aria-label="Closed Loop — home">
      <svg class="glyph" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path class="ring" d="M 12 3 a 9 9 0 1 1 -8.6 6.3" />
        <path d="M 1 7 l 2.4 2.6 L 6.2 7.4" />
      </svg>
      <span>Closed Loop</span>
    </a>
    <nav>
      {links.map((l) => (
        <a href={l.href} class:list={{ active: path.startsWith(l.href) }}>{l.label}</a>
      ))}
      <a class="hire" href="/services/#contact">Hire us</a>
    </nav>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  /* once scrolled, show the hairline */
  :global(html[style*="--scroll-y"]) header { border-bottom-color: var(--border); }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 1rem;
  }
  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }
  .wordmark:hover { text-decoration: none; }
  .glyph { color: var(--accent); flex-shrink: 0; }
  .ring { stroke-dasharray: 60; stroke-dashoffset: 0; transition: stroke-dashoffset 0.6s var(--ease-in-out); }
  .wordmark:hover .ring { stroke-dashoffset: 60; }
  nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }
  nav a { color: var(--muted); position: relative; padding-block: 0.2rem; }
  nav a::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    width: 100%; height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s var(--ease-out);
  }
  nav a:hover, nav a.active { color: var(--text-strong); text-decoration: none; }
  nav a:hover::after, nav a.active::after { transform: scaleX(1); transform-origin: left; }
  .hire {
    color: var(--accent) !important;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 6px;
    padding: 0.35rem 0.85rem !important;
    transition: background 0.25s, color 0.25s;
  }
  .hire::after { display: none; }
  .hire:hover { background: var(--accent); color: var(--accent-ink) !important; }
  @media (max-width: 520px) {
    nav { gap: 0.9rem; font-size: 0.88rem; }
    .wordmark span { display: none; }
    .hire { padding: 0.3rem 0.65rem !important; }
  }
</style>
