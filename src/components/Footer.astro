---
const year = new Date().getFullYear();
import { TURNSTILE_SITE_KEY as siteKey } from '../config';
---

<footer>
  <div class="container top">
    <div class="brand">
      <p class="eyebrow">Closed Loop</p>
      <p class="line">AI systems that close their own loop.<br />Built, verified, handed over.</p>
      <form class="subscribe" data-form action="/api/subscribe" method="post" data-success="You're on the list. New articles only — no drip campaigns." novalidate>
        <label for="sub-email">New articles by email</label>
        <div class="row">
          <input id="sub-email" type="email" name="email" required maxlength="200" placeholder="you@company.com" autocomplete="email" inputmode="email" />
          <button class="btn" type="submit">Subscribe</button>
        </div>
        <label class="hp" aria-hidden="true"><span>Website</span><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="cf-turnstile" data-sitekey={siteKey} data-action="subscribe" data-theme="dark" data-size="flexible" data-appearance="interaction-only"></div>
        <p class="status" data-status role="status" aria-live="polite"></p>
        <p class="tiny">One email per article, unsubscribe in every one. Nothing else is done with the address.</p>
      </form>
    </div>
    <div class="cols">
      <div>
        <p class="head">Site</p>
        <a href="/blog/">Writing</a>
        <a href="/about/">About</a>
        <a href="/services/">Services</a>
      </div>
      <div>
        <p class="head">Elsewhere</p>
        <a href="/rss.xml">RSS</a>
        <a href="/llms.txt">llms.txt</a>
        <a href="/services/#contact">Contact</a>
      </div>
    </div>
  </div>
  <div class="container bottom">
    <span>© {year} Closed Loop — AI engineering, Sheffield, UK</span>
    <span class="mono">Astro · static · no trackers</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--surface) 60%, transparent));
  }
  .top {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    padding-block: 3rem 2rem;
  }
  .line {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    color: var(--text-strong);
    line-height: 1.3;
    margin: 0.75rem 0 0;
    letter-spacing: -0.01em;
  }
  .subscribe { margin-top: 1.5rem; display: grid; gap: 0.5rem; max-width: 26rem; }
  .subscribe > label { font-family: var(--font-heading); font-size: 0.9rem; color: var(--text); }
  .subscribe .row { display: flex; gap: 0.5rem; }
  .subscribe input[type="email"] {
    flex: 1; min-width: 0; font: 0.95rem var(--font-body); color: var(--text-strong); background: var(--bg);
    border: 1px solid var(--border-strong); border-radius: 6px; padding: 0.55rem 0.75rem;
  }
  .subscribe input:focus { outline: none; border-color: var(--accent); }
  .subscribe .btn { --pad: 0.55rem 1rem; font-size: 0.9rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .status { margin: 0; font-family: var(--font-heading); font-size: 0.88rem; min-height: 1.2em; }
  .status[data-kind="ok"] { color: var(--accent); }
  .status[data-kind="error"] { color: #f08e8e; }
  .subscribe.sent .row, .subscribe.sent .cf-turnstile { display: none; }
  .tiny { margin: 0; font-family: var(--font-mono); font-size: 0.7rem; color: var(--muted); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .cols a {
    display: block;
    color: var(--muted);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    padding-block: 0.2rem;
    transition: color 0.2s, transform 0.25s var(--ease-out);
  }
  .cols a:hover { color: var(--text-strong); text-decoration: none; transform: translateX(3px); }
  .head { font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin: 0 0 0.6rem; }
  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .mono { font-family: var(--font-mono); font-size: 0.75rem; }
  @media (max-width: 640px) {
    .top { grid-template-columns: 1fr; }
  }
</style>
