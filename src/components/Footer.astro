---
const year = new Date().getFullYear();
---

<footer>
  <div class="container inner">
    <span>© {year} Closed Loop — Damian, Sheffield UK</span>
    <span class="links">
      <a href="/rss.xml">RSS</a>
      <a href="mailto:damian@amrsoftware.com">Email</a>
    </span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 5rem;
  }
  .inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .links { display: flex; gap: 1rem; }
</style>
