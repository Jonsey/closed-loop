---
/**
 * The enquiry form. Posts to /api/contact on the edge worker (worker/index.ts), which
 * verifies Turnstile and sends the message through Resend. The mailto stays as a
 * visible fallback — a form that fails silently is worse than no form.
 *
 * PUBLIC_TURNSTILE_SITE_KEY is a build-time env var; the default is Cloudflare's
 * always-passes test key so local builds work without an account.
 */
interface Props { heading?: string; sub?: string; compact?: boolean }
const {
  heading = 'Tell us what has to be right.',
  sub = 'What is hurting, roughly what it costs you, and how to reach you. You get a straight answer on whether Closed Loop is the right fit — including when it isn’t.',
  compact = false,
} = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';
const fallback = 'hello@closed-loop.dev';
---

<div class:list={['contact-card', { compact }]} id="contact">
  <div class="intro">
    <p class="eyebrow">Get in touch</p>
    <h2>{heading}</h2>
    <p class="sub">{sub}</p>
    <p class="alt">Prefer email? <a href={`mailto:${fallback}?subject=AI%20engineering%20enquiry`}>{fallback}</a></p>
  </div>

  <form data-form action="/api/contact" method="post" data-success="Sent. You will hear back within one working day." novalidate>
    <div class="two">
      <label><span>Name</span><input type="text" name="name" required maxlength="120" autocomplete="name" /></label>
      <label><span>Email</span><input type="email" name="email" required maxlength="200" autocomplete="email" inputmode="email" /></label>
    </div>
    <label><span>Roughly what it costs you <em>(optional — hours a week, missed enquiries, a number if you have one)</em></span><input type="text" name="cost" maxlength="200" /></label>
    <label><span>What is the problem?</span><textarea name="message" required minlength="10" maxlength="5000" rows="5"></textarea></label>
    <label class="hp" aria-hidden="true"><span>Website</span><input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    <div class="cf-turnstile" data-sitekey={siteKey} data-action="contact" data-theme="dark" data-size="flexible"></div>
    <div class="actions">
      <button class="btn primary" type="submit">Send the problem <span class="arrow">→</span></button>
      <p class="status" data-status role="status" aria-live="polite"></p>
    </div>
    <p class="privacy">Goes straight to an inbox, nothing else. No list, no tracking — reply-to is you.</p>
  </form>
</div>

<style>
  .contact-card {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.75rem, 4vw, 3rem); border: 1px solid var(--border); border-radius: 12px;
    background: radial-gradient(50% 100% at 0% 100%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%), var(--surface);
  }
  .intro h2 { margin: 0.5rem 0 0.75rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .sub { margin: 0; color: var(--muted); max-width: 40ch; }
  .alt { margin: 1.25rem 0 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }

  form { display: grid; gap: 0.9rem; align-content: start; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  label { display: grid; gap: 0.35rem; font-family: var(--font-heading); font-size: 0.9rem; color: var(--text); }
  label em { font-style: normal; color: var(--muted); font-size: 0.82rem; }
  input, textarea {
    font: 1rem var(--font-body); color: var(--text-strong); background: var(--bg); border: 1px solid var(--border-strong);
    border-radius: 6px; padding: 0.6rem 0.75rem; width: 100%; resize: vertical;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cf-turnstile { min-height: 65px; }
  .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .status { margin: 0; font-family: var(--font-heading); font-size: 0.92rem; min-height: 1.4em; }
  .status[data-kind="ok"] { color: var(--accent); }
  .status[data-kind="error"] { color: #f08e8e; }
  .status[data-kind="busy"] { color: var(--muted); }
  form.sent .two, form.sent > label, form.sent .cf-turnstile, form.sent button { display: none; }
  form.sent .status { font-size: 1.1rem; }
  .privacy { margin: 0; font-family: var(--font-mono); font-size: 0.74rem; color: var(--muted); }

  @media (max-width: 860px) {
    .contact-card { grid-template-columns: 1fr; }
    .two { grid-template-columns: 1fr; }
  }
</style>
