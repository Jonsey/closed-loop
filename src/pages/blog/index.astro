---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Writing — Closed Loop"
  description="Long-form articles on agentic systems, Claude Code, and AI infrastructure — from systems that actually ran."
>
  <section class="container">
    <div class="head">
      <p class="eyebrow" data-reveal>Writing</p>
      <h1 data-reveal style="--i:1">Articles</h1>
      <p class="intro" data-reveal style="--i:2">
        Long-form, evidence-first write-ups of the AI systems Closed Loop builds and
        runs: what was built, what broke, and the rule each failure produced.
      </p>
    </div>
    <div class="list">
      {posts.map((post, i) => <div data-reveal style={`--i:${Math.min(i, 5)}`}><PostCard post={post} index={i} /></div>)}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(3rem, 8vh, 5.5rem) 1rem; }
  .head h1 { font-size: clamp(2.4rem, 5.5vw, 4rem); margin-block: 1rem 1rem; }
  .intro { max-width: 42rem; color: var(--muted); margin: 0; }
  .list { display: grid; margin-block: 2.5rem 3rem; }
</style>
