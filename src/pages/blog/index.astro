---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Writing — Closed Loop"
  description="Long-form articles on agentic systems, Claude Code, and AI infrastructure — from systems that actually ran."
>
  <section class="container">
    <p class="eyebrow" style="margin-top: 3rem;">Writing</p>
    <h1>Articles</h1>
    <p class="intro">
      Long-form, evidence-first write-ups of AI systems in production: what was built,
      what broke, and the rule each failure produced.
    </p>
    <div class="list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 42rem; color: var(--muted); }
  .list {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-block: 2.5rem 3rem;
  }
</style>
