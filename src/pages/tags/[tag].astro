---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag} — Closed Loop`} description={`Articles tagged ${tag}.`}>
  <section class="container">
    <div class="head">
      <p class="eyebrow" data-reveal>Tag</p>
      <h1 data-reveal style="--i:1">#{tag}</h1>
    </div>
    <div class="list">
      {posts.map((post, i) => <div data-reveal style={`--i:${Math.min(i, 5)}`}><PostCard post={post} index={i} /></div>)}
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(3rem, 8vh, 5.5rem) 1rem; }
  .head h1 { font-size: clamp(2.4rem, 5.5vw, 4rem); margin-block: 1rem 0; }
  .list { display: grid; margin-block: 2.5rem 3rem; }
</style>
