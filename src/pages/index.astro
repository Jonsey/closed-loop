---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import LoopDiagram from '../components/LoopDiagram.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 4);

const principles = [
  {
    n: '01',
    title: 'State lives in plain files.',
    body: 'A task is a markdown file in a folder, and the folder is the state. No hidden database, no dashboard that lies. Anyone — human or agent — can read the truth with ls.',
  },
  {
    n: '02',
    title: 'Verification by evidence, not assertion.',
    body: 'An agent saying "done" is a claim. A baseline diff, a test run, a screenshot in the record — that is evidence. Every loop we build has a gate that only evidence opens.',
  },
  {
    n: '03',
    title: 'Separation of duties, enforced by capability.',
    body: 'The agent that writes code cannot merge it. The agent that reviews cannot edit. Not because the prompt says so — because the tools it holds make it impossible.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Closed Loop',
  url: Astro.site?.href,
  description: 'AI engineering consultancy — agentic systems, Claude Code enablement, and AI infrastructure, evidenced.',
  email: 'hello@closed-loop.dev',
  address: { '@type': 'PostalAddress', addressLocality: 'Sheffield', addressCountry: 'GB' },
  areaServed: 'Remote',
  founder: { '@type': 'Person', name: 'Damian', jobTitle: 'Senior AI Engineer' },
};
---

<Base
  title="Closed Loop — AI engineering, evidenced"
  description="Closed Loop is an AI engineering consultancy building agentic systems, Claude Code workflows, and AI infrastructure that have to be right. Every method ran for real before it was written up."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero container">
    <div class="copy">
      <p class="eyebrow" data-reveal style="--i:0">AI Engineering Consultancy · Sheffield, UK · Remote</p>
      <h1 data-reveal style="--i:1">
        Systems that<br />close their own loop.
      </h1>
      <p class="lede" data-reveal style="--i:2">
        Closed Loop designs and builds production AI systems for businesses that
        need them to be right: autonomous dev loops on Claude Code, multi-agent
        pipelines, and the cloud infrastructure underneath them. Every method we
        sell ran for real before it was written up. No thought experiments —
        <em>scars with documentation</em>.
      </p>
      <div class="cta" data-reveal style="--i:3">
        <a class="btn primary" href="/services/">Work with us <span class="arrow">→</span></a>
        <a class="btn" href="/blog/">Read the writing</a>
      </div>
    </div>
    <div class="figure parallax" data-speed="0.12" data-reveal="scale" style="--i:2">
      <LoopDiagram />
    </div>
    <a class="scroll-cue" href="#principles" aria-label="Scroll to how we work">
      <span></span>
    </a>
  </section>

  <!-- ── Big statement ────────────────────────────────────── -->
  <section class="statement">
    <div class="container">
      <p data-reveal>
        Most AI demos are open loops: a prompt goes in, text comes out, and nobody
        checks. A <strong>closed loop</strong> feeds its own output back through a
        gate — verified, reviewed, recorded — before it's allowed to count.
        That gate is the whole discipline, and it is what Closed Loop builds.
      </p>
    </div>
  </section>

  <!-- ── Principles ───────────────────────────────────────── -->
  <section id="principles" class="container principles">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">How we work</p>
        <h2>Three rules, each one a scar.</h2>
      </div>
      <a class="aside" href="/how-we-work/">How we diagnose and price →</a>
    </div>
    <div class="grid">
      {principles.map((p, i) => (
        <article class="principle" data-reveal style={`--i:${i}`}>
          <span class="n">{p.n}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ── Latest writing ───────────────────────────────────── -->
  <section class="container writing">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Latest writing</p>
        <h2>Systems, explained from the inside.</h2>
      </div>
      <a class="aside" href="/blog/">All articles →</a>
    </div>
    <div class="list">
      {latest.map((post, i) => <div data-reveal style={`--i:${i}`}><PostCard post={post} index={i} /></div>)}
    </div>
  </section>

  <!-- ── CTA band ─────────────────────────────────────────── -->
  <section class="band">
    <svg class="ghost parallax" data-speed="0.25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
      <path d="M 12 3 a 9 9 0 1 1 -8.6 6.3" />
      <path d="M 1 7 l 2.4 2.6 L 6.2 7.4" />
    </svg>
    <div class="container inner">
      <p class="eyebrow" data-reveal>Available for remote engagements</p>
      <h2 data-reveal style="--i:1">Need an AI system that has to be right,<br />not just impressive?</h2>
      <p class="sub" data-reveal style="--i:2">
        Agentic system design, Claude Code enablement for engineering teams, and the
        infrastructure that keeps LLM products production-grade — delivered by a
        senior engineer, not a slide deck.
      </p>
      <div class="cta" data-reveal style="--i:3">
        <a class="btn primary" href="/services/#contact">Start a conversation <span class="arrow">→</span></a>
        <a class="btn" href="/how-we-work/">How pricing works</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 3rem;
    padding-block: clamp(3rem, 9vh, 7rem) 4rem;
    min-height: calc(100vh - 4.5rem);
    position: relative;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 6.2vw, 4.4rem);
    margin-block: 1rem 1.5rem;
    line-height: 1.05;
  }
  .lede { font-size: clamp(1.1rem, 1.5vw, 1.25rem); max-width: 40rem; color: var(--text); margin: 0; }
  .cta { display: flex; gap: 0.9rem; margin-top: 2.25rem; flex-wrap: wrap; }
  .figure { max-width: 32rem; margin-inline: auto; width: 100%; }
  .scroll-cue {
    position: absolute;
    left: clamp(1.25rem, 4vw, 2.5rem);
    bottom: 1.5rem;
    width: 1.5rem; height: 2.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    display: grid; place-items: start center;
    padding-top: 0.4rem;
  }
  .scroll-cue span {
    width: 3px; height: 6px; border-radius: 2px; background: var(--accent);
    animation: cue 1.8s var(--ease-in-out) infinite;
  }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1 } 70% { transform: translateY(14px); opacity: 0 } 100% { opacity: 0 } }

  /* Statement */
  .statement {
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    padding-block: clamp(3rem, 7vw, 5.5rem);
    margin-block: 2rem 0;
  }
  .statement p {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--muted);
    max-width: 60rem;
    margin: 0;
    text-wrap: balance;
  }
  .statement strong { color: var(--accent); font-weight: 500; }

  /* Principles */
  .principles { padding-block: clamp(4rem, 8vw, 6.5rem) 2rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
  }
  .principle {
    padding: 2rem 1.75rem 2.25rem;
    border-right: 1px solid var(--border);
    position: relative;
    transition: background 0.3s;
  }
  .principle:last-child { border-right: 0; }
  .principle:hover { background: var(--surface-2); }
  .principle::before {
    content: '';
    position: absolute; left: 0; top: 0; width: 100%; height: 2px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .principle:hover::before { transform: scaleX(1); }
  .n { font-family: var(--font-mono); color: var(--accent); font-size: 0.8rem; letter-spacing: 0.1em; }
  .principle h3 { margin: 0.9rem 0 0.7rem; font-size: 1.3rem; }
  .principle p { margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.65; }

  /* Writing */
  .writing { padding-block: clamp(3rem, 7vw, 5.5rem) 1rem; }
  .list { display: grid; }

  /* Band */
  .band {
    position: relative;
    overflow: hidden;
    margin-top: clamp(4rem, 8vw, 6.5rem);
    border-top: 1px solid var(--border);
    background:
      radial-gradient(60% 80% at 100% 50%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--surface);
  }
  .band .inner { padding-block: clamp(4rem, 9vw, 7rem); position: relative; max-width: var(--wide); }
  .band h2 { font-size: clamp(1.9rem, 4vw, 3rem); margin-block: 0.75rem 1rem; }
  .band .sub { max-width: 44rem; color: var(--muted); margin: 0; font-size: 1.1rem; }
  .ghost {
    position: absolute;
    right: -6vw; top: 50%;
    width: min(44vw, 34rem); height: auto;
    color: var(--accent);
    opacity: 0.09;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: 0; padding-block: 3.5rem 2rem; }
    .figure { max-width: 22rem; order: -1; }
    .scroll-cue { display: none; }
    .grid { grid-template-columns: 1fr; }
    .principle { border-right: 0; border-bottom: 1px solid var(--border); }
    .principle:last-child { border-bottom: 0; }
  }
</style>
